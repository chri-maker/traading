# Copy this file to ".env" and fill in your real credentials.
# The ".env" file is gitignored — never commit real keys.
#
# Get paper-trading keys at: https://app.alpaca.markets/ (Paper Trading -> API Keys)

# Alpaca API credentials (PAPER trading)
ALPACA_API_KEY_ID=PKXXXXXXXXXXXXXXXXXXXX
ALPACA_API_SECRET_KEY=your_secret_key_here

# Paper endpoint (default). Use https://api.alpaca.markets for LIVE — at your own risk.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Strategy / bot configuration ---
# Comma-separated symbols to trade
SYMBOLS=AAPL,MSFT,SPY

# Moving-average crossover windows (in bars)
FAST_WINDOW=10
SLOW_WINDOW=30

# Bar timeframe for signals: 1Min, 5Min, 15Min, 1Hour, 1Day
TIMEFRAME=1Day

# Fraction of available buying power to allocate per position (0.0 - 1.0)
POSITION_SIZE=0.1

# How often the live bot re-evaluates, in seconds
POLL_INTERVAL=60

# ===========================================================================
# Congress-mirror bot (scripts/daily_job.py, scripts/rank_members.py)
# ===========================================================================

# Data provider for congressional disclosures: fmp | sample
CONGRESS_PROVIDER=fmp

# Financial Modeling Prep API key (free tier). Get one at:
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_fmp_api_key_here

# Ranking window + activity threshold
CONGRESS_WINDOW_DAYS=365
CONGRESS_MIN_TRADES=3

# Fraction of account equity to deploy across the mirrored book (0.0 - 1.0)
MIRROR_ALLOCATION=0.5
# Optional: cap the mirror to the N largest convictions (blank = no cap)
MIRROR_MAX_POSITIONS=

# Set to true to compute + email but place NO orders
MIRROR_DRY_RUN=false

# --- Email (Gmail SMTP) ---
# Gmail needs an App Password (2FA on): https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=your_gmail_address@gmail.com
EMAIL_TO=c.vitale077@gmail.com
