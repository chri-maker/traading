# Copy this file to ".env" and fill in your real credentials.
# The ".env" file is gitignored — never commit real keys.
#
# Get paper-trading keys at: https://app.alpaca.markets/ (Paper Trading -> API Keys)

# Alpaca API credentials (PAPER trading)
ALPACA_API_KEY_ID=PKXXXXXXXXXXXXXXXXXXXX
ALPACA_API_SECRET_KEY=your_secret_key_here

# Paper endpoint (default). Use https://api.alpaca.markets for LIVE — at your own risk.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Strategy / bot configuration ---
# Comma-separated symbols to trade
SYMBOLS=AAPL,MSFT,SPY

# Moving-average crossover windows (in bars)
FAST_WINDOW=10
SLOW_WINDOW=30

# Bar timeframe for signals: 1Min, 5Min, 15Min, 1Hour, 1Day
TIMEFRAME=1Day

# Fraction of available buying power to allocate per position (0.0 - 1.0)
POSITION_SIZE=0.1

# How often the live bot re-evaluates, in seconds
POLL_INTERVAL=60

# ===========================================================================
# Congress-mirror bot (scripts/daily_job.py, scripts/rank_members.py)
# ===========================================================================

# Data provider for congressional disclosures: stockwatcher | fmp | sample
#   stockwatcher = free, no API key (House/Senate Stock Watcher public data)
#   fmp          = Financial Modeling Prep (needs FMP_API_KEY, paid for congress)
CONGRESS_PROVIDER=stockwatcher

# Only needed if CONGRESS_PROVIDER=fmp. Get a key at:
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Ranking window + activity threshold
CONGRESS_WINDOW_DAYS=365
CONGRESS_MIN_TRADES=3
# How many pages of latest disclosures to pull. FMP free plan caps 25 rows/page
# and ~250 requests/day; 40 pages x 2 chambers = 80 calls/run, ~2000 rows.
# Ignored by the free archive source.
CONGRESS_FETCH_PAGES=40

# Fraction of account equity to deploy across the mirrored book (0.0 - 1.0)
MIRROR_ALLOCATION=0.5
# Optional: cap the mirror to the N largest convictions (blank = no cap)
MIRROR_MAX_POSITIONS=
# Optional: cap any single name's share of the mirror, e.g. 0.34 = max 34%
# (blank = no cap). Stops one huge disclosed buy from dominating the account.
MIRROR_MAX_POSITION_PCT=

# Set to true to compute + email but place NO orders
MIRROR_DRY_RUN=false
# Safety: the bot REFUSES to trade a non-paper account unless this is true.
MIRROR_ALLOW_LIVE=false

# --- Email (Gmail SMTP) ---
# Gmail needs an App Password (2FA on): https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=your_gmail_address@gmail.com
EMAIL_TO=c.vitale077@gmail.com

# ===========================================================================
# AI-driven strategy (scripts/ai_trade.py) — Claude picks the portfolio
# ===========================================================================

# Anthropic API key (https://console.anthropic.com/) — required for the AI bot
ANTHROPIC_API_KEY=

# Model + token budget per run
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=2000

# Fraction of equity to deploy, max number of names, and per-name cap
AI_ALLOCATION=0.5
AI_MAX_POSITIONS=8
AI_MAX_POSITION_PCT=0.25

# Tradable universe (blank = built-in liquid large-cap list)
AI_UNIVERSE=
# Include congressional-trade signals in the prompt (needs FMP_API_KEY)
AI_USE_CONGRESS=true

# Safety: refuse non-paper account unless true; dry-run computes without trading
AI_ALLOW_LIVE=false
AI_DRY_RUN=false

# ===========================================================================
# Diversified basket (scripts/basket_trade.py) — rules-based, no AI/key
# ===========================================================================

# Equal-weight universe (blank = built-in ~18 stocks + BTC/USD,ETH/USD).
# Crypto uses the SLASH form, e.g. BTC/USD.
BASKET_UNIVERSE=
# Number of positions to hold, fraction of equity to deploy
# (>1.0 uses margin; ~1.8-2.0 is the practical overnight max a held basket can
# sustain before Reg-T forces liquidation. 4x is intraday-only, not holdable.)
BASKET_SIZE=20
BASKET_ALLOCATION=1.8
# Safety
BASKET_ALLOW_LIVE=false
BASKET_DRY_RUN=false
